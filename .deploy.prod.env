REMOTE_HOST=nezus.cn
REMOTE_USER=root
REMOTE_PORT=22

REMOTE_APP_DIR=/root/web/resume-editor
REMOTE_ENV_FILE=/root/envs/resume-editor/.env
PM2_APP_NAME=ResumeEditor
APP_PORT=4787

RUN_INSTALL=1
RUN_LINT=0

LOCAL_INSTALL_CMD="npm install"
LOCAL_BUILD_CMD="env NODE_OPTIONS=--max-old-space-size=4096 npm run build"
REMOTE_INSTALL_CMD="npm install --production=false"
